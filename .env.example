# ---------------------------------------------------------------------------
# CampusMood AI — environment variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit .env, .env.local, or service-role keys to version control.
# ---------------------------------------------------------------------------

# Supabase (OPTIONAL).
# Leave unset to run in "local-only" mode: sessions and preferences are stored
# in the browser (localStorage) and authentication is handled by the built-in
# local auth adapter. Set both values to switch to Supabase Auth + Postgres.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public origin used for links in emails / CORS allow-lists (no secret value).
VITE_APP_URL=http://localhost:5173

# MediaPipe face landmarker model.
# Point this at your own hosted `.task` bundle to avoid depending on the
# public CDN. Requires a network fetch on first load either way.
VITE_FACE_LANDMARKER_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task

# MediaPipe WASM assets (CDN or self-hosted directory).
VITE_MEDIAPIPE_WASM_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.22/wasm
